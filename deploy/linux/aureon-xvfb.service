# Aureon MT5 on Linux (docs/LINUX_SETUP.md): the virtual display the MT5 terminal draws on.
[Unit]
Description=Aureon MT5: virtual display :99 (Xvfb)
After=network.target

[Service]
User=svskhd8
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
