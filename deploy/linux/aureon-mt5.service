# Aureon MT5 on Linux (docs/LINUX_SETUP.md): the MetaTrader 5 terminal under Wine.
# The Linux twin of the Windows "Aureon-MT5" logon task. The bot's preflight cannot start the
# terminal under Wine (it uses PowerShell), so AUREON_MT5_PATH stays unset and systemd owns it.
[Unit]
Description=Aureon MT5: MetaTrader 5 terminal (Wine)
Requires=aureon-xvfb.service
After=aureon-xvfb.service network-online.target
Wants=network-online.target

[Service]
User=svskhd8
Environment=DISPLAY=:99
Environment=WINEPREFIX=/home/svskhd8/.wine
Environment=WINEDEBUG=-all
ExecStart=/usr/bin/wine "C:\\Program Files\\MetaTrader 5\\terminal64.exe"
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
