# copy to .env (never committed) and load it in your shell before running
DISCORD_WEBHOOK=Wq_iy5M39wXfW
DISCORD_TOKEN=M
AUREON_MODE=ema5080
AUREON_SYMBOLS=XAUUSD
AUREON_SERVER_OFFSET=3
# optional: bot / Claude health cards go here instead of DISCORD_WEBHOOK (v1.9.8)
DISCORD_HEALTH_WEBHOOK=
# Claude add-on (v1.10.0) — local `claude -p` with your Claude Code login. No API key. off | review | advisory | manage
AUREON_CLAUDE=off
AUREON_CLAUDE_BIN=claude
AUREON_CLAUDE_ENTRY_MODEL=opus
AUREON_CLAUDE_PULLBACK_MODEL=sonnet
AUREON_CLAUDE_REVIEW_MODEL=haiku
AUREON_CLAUDE_MAX_CALLS=30
AUREON_CLAUDE_TIMEOUT=90
AUREON_CLAUDE_WORKDIR=C:\aureon_claude
# v1.11.0 weekly compare: 1 = after the Saturday COMPARE card, Claude reviews its own wrong calls (counts toward the daily budget)
AUREON_COMPARE_CLAUDE_REVIEW=0
# v2.0.0 /alert buttons may place the order only with execution on, on a demo account (AUREON_ALLOW_LIVE=1 to allow a real account)
AUREON_EXECUTION=0
AUREON_ALLOW_LIVE=0
AUREON_MAX_LOTS=1.0
# v2.3.7 lot-size buttons on entry cards when execution is on (AUREON_MAX_LOTS still caps every button; AUREON_ALLOW_LIVE=1 required on real accounts)
AUREON_LOT_BUTTONS=0.5,1.0,1.5
# v2.3.4 streak half size: 0 = off; when >= N consecutive losses, lot size is halved (AUREON_MAX_LOTS still caps)
AUREON_STREAK_HALF_AFTER=0
# v2.3.5 chop-day flag: if >= N EMA crosses before 11:00 server, the day is CHOP (half size, warning on ENTER cards)
AUREON_CHOP_CROSSES=5
# v2.3.9 missed setup: grace window before a SETUP MISSED card; override window and max drift for /override
AUREON_MISSED_GRACE_MIN=5
AUREON_OVERRIDE_WINDOW_MIN=10
AUREON_OVERRIDE_MAX_DRIFT=3.0
# v2.3.12 risk governor (enforced — cannot be bypassed)
AUREON_MAX_TRADES_DAY=4
AUREON_LOSS_MULTIPLE=2.0
# v2.3.10 watchdog: on by default; heartbeat card every N hours (aligned to IST 00/04/08…)
AUREON_WATCHDOG=1
AUREON_HEARTBEAT_HOURS=4
# Supabase minute ping (off by default, unrelated to the Discord watchdog)
# AUREON_SUPABASE_PING=0
# v2.0.2 slash-command sync target (guild id); unset = global sync
DISCORD_GUILD=
