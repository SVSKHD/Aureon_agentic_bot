# copy to .env (never committed) and load it in your shell before running
DISCORD_WEBHOOK=Wq_iy5M39wXfW
DISCORD_TOKEN=M
AUREON_MODE=ema5080
AUREON_SYMBOLS=XAUUSD
AUREON_SERVER_OFFSET=3
# optional: bot / Claude health cards go here instead of DISCORD_WEBHOOK (v1.9.8)
DISCORD_HEALTH_WEBHOOK=
# Claude add-on (v1.10.0) — local `claude -p` with your Claude Code login. No API key. off | review | advisory | manage
AUREON_CLAUDE=off
AUREON_CLAUDE_BIN=claude
AUREON_CLAUDE_ENTRY_MODEL=opus
AUREON_CLAUDE_PULLBACK_MODEL=sonnet
AUREON_CLAUDE_REVIEW_MODEL=haiku
# calls per IST day, all symbols. v2.8.0 adds +1 per trade at open and 0–3 in drawdown (+ flip-held, /claude-read): 100 suggested
AUREON_CLAUDE_MAX_CALLS=30
AUREON_CLAUDE_TIMEOUT=90
AUREON_CLAUDE_WORKDIR=C:\aureon_claude
# v1.11.0 weekly compare: 1 = after the Saturday COMPARE card, Claude reviews its own wrong calls (counts toward the daily budget)
AUREON_COMPARE_CLAUDE_REVIEW=0
# v2.0.0 /alert buttons may place the order only with execution on, on a demo account (AUREON_ALLOW_LIVE=1 to allow a real account)
AUREON_EXECUTION=0
AUREON_ALLOW_LIVE=0
AUREON_MAX_LOTS=1.0
# v2.3.7 lot-size buttons on entry cards when execution is on (AUREON_MAX_LOTS still caps every button; AUREON_ALLOW_LIVE=1 required on real accounts)
AUREON_LOT_BUTTONS=0.5,1.0,1.5
# v2.3.4 streak half size: 0 = off; when >= N consecutive losses, lot size is halved (AUREON_MAX_LOTS still caps)
AUREON_STREAK_HALF_AFTER=0
# v2.3.5 chop-day flag: if >= N EMA crosses before 11:00 server, the day is CHOP (half size, warning on ENTER cards)
AUREON_CHOP_CROSSES=5
# v2.5.2 ema2050 PRE-CROSS heads-up (notification only, no trade)
AUREON_PRE_ALERT_2050=1
# v2.5.2 p_win floor in AGENT mode (0 = off; only when the advisor is calibrated as useful)
AUREON_PWIN_FLOOR=0
AUREON_PWIN_WAIT_S=15
# v2.5.3 end-of-day Codex review (read-only, at IST time)
AUREON_EOD_AT=23:15
# v2.6.2 event publisher for follower copier (optional, needs redis)
AUREON_PUBLISH=0
REDIS_URL=
# v2.3.9 missed setup: grace window before a SETUP MISSED card; override window and max drift for /override
AUREON_MISSED_GRACE_MIN=5
AUREON_OVERRIDE_WINDOW_MIN=10
AUREON_OVERRIDE_MAX_DRIFT=3.0
# v2.4.1 AGENT mode: default window duration in minutes
AUREON_AGENT_DEFAULT_MIN=60
# v2.4.2 AGENT delay before autonomous entry (gives human first refusal)
AUREON_AGENT_DELAY_S=20
# v2.4.5 early lock mode: soft (bar close based, default) | hard (broker SL, old behaviour) | off
AUREON_EARLY_LOCK_MODE=soft
AUREON_SOFT_FALLBACK_MIN=5
# v2.7.0/v2.7.1 guardian profile: "auto" = leg on demo, classic on live | "leg" | "classic"
AUREON_GUARDIAN_PROFILE=auto
AUREON_GUARDIAN_PROFILE_DEMO=leg
AUREON_SOFT_ARM_PTS=5
AUREON_SOFT_GIVEBACK_PTS=3.0
AUREON_SOFT_GIVEBACK_FRAC=0.5
AUREON_RIDE_FLOOR=4
AUREON_RIDE_SWING_BARS=6
AUREON_RIDE_BUFFER=1.0
AUREON_RIDE_ATR_MULT=3.0
# v2.3.12 risk governor (enforced — cannot be bypassed)
AUREON_MAX_TRADES_DAY=4
AUREON_LOSS_MULTIPLE=2.0
# v2.3.10 watchdog: on by default; heartbeat card every N hours (aligned to IST 00/04/08…)
AUREON_WATCHDOG=1
AUREON_HEARTBEAT_HOURS=4
# Supabase minute ping (off by default, unrelated to the Discord watchdog)
# AUREON_SUPABASE_PING=0
# v2.3.15 daily plan card at IST time
AUREON_DAILY_PLAN=1
AUREON_DAILY_PLAN_AT=05:00
AUREON_WEEK_GOAL_PTS=0
# v2.3.16 voice commands (optional — whisper/faster-whisper needed for transcription)
AUREON_VOICE=0
AUREON_VOICE_CHATS=
AUREON_VOICE_SECRET=
# v2.0.2 slash-command sync target (guild id); unset = global sync
DISCORD_GUILD=

# v2.7.2 dead-man's switch (docs/SERVICE.md): pinged every 60 s only while healthy — healthchecks.io or any URL
AUREON_DEADMAN_URL=
# optional local fallback (scripts/deadman_fallback.py via Task Scheduler): Telegram alert when logs/heartbeat.txt > 5 min old
AUREON_DEADMAN_TELEGRAM=
AUREON_DEADMAN_TELEGRAM_CHAT=

# ---- v2.8.0 — Claude sees the chart, the guardian sees the setup (every guardian knob defaults to OFF = v2.7.2 behaviour)
# Claude events that get the chart PNG (prompt text only, never a trade). Empty = never. Codex never gets a chart.
AUREON_CLAUDE_IMAGE_EVENTS=P,CROSS,READ
# 1 = an opposite P closes the trade only when the structure confirms it (close through EMA80, EMA50 slope, M15, wide gap). 0 = any opposite P flips (v2.7.2)
AUREON_FLIP_REQUIRE_STRUCTURE=0
# how many of those evidence items an opposite P needs before it closes the trade (with FLIP_REQUIRE_STRUCTURE=1)
AUREON_FLIP_MIN_EVIDENCE=2
# "gap wide" evidence: |EMA fast − EMA slow| >= this × the 20-bar average range
AUREON_FLIP_GAP_X_RANGE=0.5
# close on a bar CLOSE that gave back this % of the peak (e.g. 50). 0 = off
AUREON_GIVEBACK_PCT=0
# the giveback exit is armed only once the peak reached this many points
AUREON_GIVEBACK_ARM=10
# 1 = classic profile: initial SL at the swing low/high ± BUFFER (capped at −MAX_DD), raised with the swing while under water; exit on a CLOSE that invalidates the setup; P timeout paused while the lines converge. 0 = fixed −pre_stop / 12-bar timeout (v2.7.2)
AUREON_SETUP_STOP=0
# the setup stop's hard drawdown cap in points
AUREON_SETUP_MAX_DD=10
# when > 0: cap = max(MAX_DD, this × 20-bar average range) — scales with volatility. 0 = fixed MAX_DD
AUREON_SETUP_MAX_DD_X_RANGE=0
# swing window (closed bars) for the setup stop and the swing check
AUREON_SETUP_SWING_BARS=6
# points beyond the swing / EMA80 before it counts
AUREON_SETUP_BUFFER=1.0
# 1 = one Claude READ when a position is first seen (shown only, never applied). 0 = off
AUREON_CLAUDE_OPEN_READ=1
# a Claude drawdown READ fires when a bar closes this many points under water (setup still alive). 0 = off
AUREON_DD_READ_AT=3
# re-arm: a new trough at least this many points deeper (or one last-chance read within 2 pts of the cap)
AUREON_DD_READ_STEP=2
# at most this many drawdown READs per trade
AUREON_DD_READS_PER_TRADE=3
# 1 = in manage mode a drawdown EXIT may close a LOSING trade (never from open / flip-held / /claude-read). 0 = shown only
AUREON_CLAUDE_EXIT_LOSING=0

# ---- v2.10.0 — every toggle is also live from Discord: /features, /feature-set (admin), /feature-reset; Discord wins over .env
# repair agent: off = card only · propose = tested patch on a branch · auto = apply plumbing fixes only when flat, outside the session, suite green
AUREON_REPAIR_AGENT=off
# auto tier: at most this many auto-applied repairs per IST day
AUREON_REPAIR_AUTO_PER_DAY=2
# an auto-applied repair is verified after this many healthy seconds, else rolled back
AUREON_REPAIR_VERIFY_S=600
# the fixer CLI for /repair: claude (claude -p) or codex (codex exec)
AUREON_REPAIR_ENGINE=claude
# Claude model the fixer uses
AUREON_REPAIR_MODEL=opus
# seconds the fixer may run before it is stopped
AUREON_REPAIR_TIMEOUT=900
# 1 = zero-lag EMAs, HMA, ADX, KAMA, VWAP in Claude's snapshot and on the chart (no rule reads them). 0 = off
AUREON_ZL_CONTEXT=0
# 1 = "ZL cross against" counts as flip evidence (only ever adds evidence). 0 = off
AUREON_FLIP_USE_ZL=0
# regime gate: off = compute + journal only · show = REGIME line on entry cards · block = no ask / no Claude entry read in CHOPPY/DEAD
AUREON_REGIME_GATE=off
# enter CHOPPY below this regime score (0 = dead chop … 1 = clean trend)
AUREON_REGIME_CHOPPY=0.45
# enter DEAD below this regime score
AUREON_REGIME_DEAD=0.25
# a bar at or above this score counts toward leaving CHOPPY
AUREON_REGIME_CLEAN=0.55
# consecutive clean bars needed to leave CHOPPY
AUREON_REGIME_CLEAN_BARS=4
# NO-TRADE DAY card once CHOPPY/DEAD covered this share of the session (after NY open) — a card, not a lock
AUREON_NO_TRADE_DAY_FRAC=0.6

# ---- v2.10.1 unattended operation + server ownership (docs/SERVICE.md)
# terminal64.exe the launcher starts before the bot (empty = the path the bot cached in logs/mt5_path.txt)
AUREON_MT5_PATH=
# seconds the bot waits for MetaTrader5.initialize() after a boot before exiting 75
AUREON_MT5_BOOT_WAIT=300
# the entry session (IST) — maintenance, auto-repair and code updates happen outside it
AUREON_SESSION_IST=05:30-23:00
# Windows Update active hours for aureon_server.ps1 -Action harden (local time, e.g. 05-23)
AUREON_SERVER_ACTIVE_HOURS=
# 1 = harden enables auto-logon for the MT5 user (needed after a reboot)
AUREON_SERVER_AUTOLOGON=1
# a pending Windows reboot may happen inside the session after this many hours — still only when flat
AUREON_SERVER_MAINT_FORCE_AFTER_H=48
# stall dumps / rotated logs / replays older than this are deleted in the maintenance window
AUREON_LOG_KEEP_DAYS=30
# strategy proposals: off · shadow (replay + graded shadow sessions) · apply (after a clean shadow, with /veto)
AUREON_TUNING_AUTO=off
# replay window for a proposal (days)
AUREON_TUNING_REPLAY_DAYS=30
# sessions a proposal must shadow cleanly before it can apply
AUREON_TUNING_SHADOW_SESSIONS=3
# auto-applied strategy changes per week
AUREON_TUNING_AUTO_PER_WEEK=1
